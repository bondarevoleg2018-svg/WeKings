
Функция ПолучитьКурс(ВалютаОтбора, НаДату) Экспорт
	
	Если ВалютаОтбора = Константы.УправленческаяВалюта.Получить() Тогда
		Возврат 1;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Период, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
	Запрос.УстановитьПараметр("Период", НаДату);
	Запрос.УстановитьПараметр("Валюта", ВалютаОтбора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Курс > 0 Тогда
		Возврат Выборка.Курс;
	КонецЕсли;
	ВызватьИсключение СтрШаблон("Не задан курс валюты ""%1"" на дату %2. Заполните регистр сведений ""Курсы валют"".",
		ВалютаОтбора, Формат(НаДату, "ДЛФ=D"));
	
КонецФункции

// Обработчик регламентного задания АктуализацияКурсовВалют.
// Для каждой валюты (кроме управленческой): если на сегодня курса нет,
// но есть прошлый — продлевает его записью на сегодня. Валюты вообще
// без курса — предупреждение в журнал регистрации.
Процедура АктуализироватьКурсыВалют() Экспорт
	
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Валюты.Ссылка КАК Валюта,
	|	Срез.Курс КАК Курс,
	|	Срез.Период КАК ПериодКурса
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Граница, ) КАК Срез
	|		ПО Срез.Валюта = Валюты.Ссылка
	|ГДЕ
	|	Валюты.Ссылка <> &УправленческаяВалюта";
	Запрос.УстановитьПараметр("Граница", КонецДня(Сегодня));
	Запрос.УстановитьПараметр("УправленческаяВалюта", Константы.УправленческаяВалюта.Получить());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Курс = NULL Тогда
			ЗаписьЖурналаРегистрации("Актуализация курсов валют",
				УровеньЖурналаРегистрации.Предупреждение, , Выборка.Валюта,
				"У валюты нет ни одного курса, актуализировать нечего");
		ИначеЕсли Выборка.ПериодКурса < Сегодня Тогда
			Запись = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
			Запись.Период = Сегодня;
			Запись.Валюта = Выборка.Валюта;
			Запись.Курс = Выборка.Курс;
			Запись.Записать();
			ЗаписьЖурналаРегистрации("Актуализация курсов валют",
				УровеньЖурналаРегистрации.Информация, , Выборка.Валюта,
				СтрШаблон("Курс %1 продлен с %2 на сегодня", Выборка.Курс,
					Формат(Выборка.ПериодКурса, "ДЛФ=D")));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
