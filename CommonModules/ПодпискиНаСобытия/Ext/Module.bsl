
Процедура ОбновитьСтатусАктаПриЗаписиОплаты(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Акт = Источник.Акт;
	Если Акт.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	// Статус считается от суммы всех проведённых оплат по акту:
	// одинаково работает при проведении, отмене проведения и пометке удаления оплаты
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Оплата.Сумма), 0) КАК СуммаОплат
	|ИЗ
	|	Документ.ОплатаОтКлиента КАК Оплата
	|ГДЕ
	|	Оплата.Акт = &Акт
	|	И Оплата.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Начисления.Сумма), 0) КАК СуммаАкта
	|ИЗ
	|	Документ.АктКлиенту.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.Ссылка = &Акт";
	Запрос.УстановитьПараметр("Акт", Акт);
	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаОплаты = Результаты[0].Выбрать();
	ВыборкаОплаты.Следующий();
	ВыборкаАкт = Результаты[1].Выбрать();
	ВыборкаАкт.Следующий();
	
	Если ВыборкаАкт.СуммаАкта > 0 И ВыборкаОплаты.СуммаОплат >= ВыборкаАкт.СуммаАкта Тогда
		НовыйСтатус = Перечисления.СтатусыАкта.Оплачен;
	Иначе
		НовыйСтатус = Перечисления.СтатусыАкта.Выставлен;
	КонецЕсли;
	
	Если Акт.Статус = НовыйСтатус Тогда
		Возврат; // статус уже нужный, лишняя запись акта не нужна
	КонецЕсли;
	
	Попытка
		АктОбъект = Акт.ПолучитьОбъект();
		АктОбъект.Статус = НовыйСтатус;
		АктОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		ВызватьИсключение СтрШаблон("Не удалось обновить статус акта ""%1"" при записи оплаты: %2",
			Акт, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры
