
Функция СформироватьПечатнуюФорму(ДокументСсылка) Экспорт
	
	Макет = Документы.ВыплатаВебМастеру.ПолучитьМакет("МакетВыплаты");
	ТабДок = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыплатаВебМастеру.Номер КАК Номер,
	|	ВыплатаВебМастеру.Дата КАК Дата,
	|	ВыплатаВебМастеру.ВебМастер КАК ВебМастер,
	|	ВыплатаВебМастеру.Сумма КАК Сумма,
	|	ВыплатаВебМастеру.Валюта КАК Валюта
	|ИЗ
	|	Документ.ВыплатаВебМастеру КАК ВыплатаВебМастеру
	|ГДЕ
	|	ВыплатаВебМастеру.Ссылка = &Ссылка";
	
	Шапка = Запрос.Выполнить().Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	ВалютаПечати = Шапка.Валюта;
	Если Не ЗначениеЗаполнено(ВалютаПечати) Тогда
		ВалютаПечати = Константы.УправленческаяВалюта.Получить();
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Номер = Шапка.Номер;
	Область.Параметры.Дата = Формат(Шапка.Дата, "ДЛФ=D");
	Область.Параметры.ВебМастер = Шапка.ВебМастер;
	Область.Параметры.Сумма = Формат(Шапка.Сумма, "ЧДЦ=2; ЧН=0,00");
	Область.Параметры.Валюта = ВалютаПечати;
	ТабДок.Вывести(Область);
	ТабДок.Вывести(Макет.ПолучитьОбласть("Подвал"));
	
	Возврат ТабДок;
	
КонецФункции
