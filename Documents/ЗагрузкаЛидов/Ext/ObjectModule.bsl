
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Оффер = Кампания.Оффер;
	КапаЛидов = Оффер.КапаЛидовВМесяц;
	
	НовыхЛидов = 0;
	Для Каждого СтрокаКонверсии Из Конверсии Цикл
		Если СтрокаКонверсии.ТипКонверсии = Перечисления.ТипыКонверсий.Лид Тогда
			НовыхЛидов = НовыхЛидов + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если КапаЛидов > 0 И НовыхЛидов > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Конверсии.Лиды), 0) КАК Лидов
		|ИЗ
		|	РегистрНакопления.Конверсии КАК Конверсии
		|ГДЕ
		|	Конверсии.Период МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И Конверсии.Кампания.Оффер = &Оффер
		|	И Конверсии.Регистратор <> &Ссылка
		|	И Конверсии.Активность";
		Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Дата));
		Запрос.УстановитьПараметр("Оффер", Оффер);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		ЛидовЗаМесяц = 0;
		Если Выборка.Следующий() Тогда
			ЛидовЗаМесяц = Выборка.Лидов;
		КонецЕсли;
		Если ЛидовЗаМесяц + НовыхЛидов > КапаЛидов Тогда
			Сообщить(СтрШаблон("Превышена капа лидов по офферу ""%1"": капа %2, уже загружено %3, новых %4.",
				Оффер, КапаЛидов, ЛидовЗаМесяц, НовыхЛидов));
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Движения.Конверсии.Записывать = Истина;
	Для Каждого СтрокаКонверсии Из Конверсии Цикл
		Движение = Движения.Конверсии.Добавить();
		Движение.Период = Дата;
		Движение.Кампания = Кампания;
		Если СтрокаКонверсии.ТипКонверсии = Перечисления.ТипыКонверсий.Депозит Тогда
			Движение.Депозиты = 1;
			Движение.СуммаДепозитов = СтрокаКонверсии.СуммаДепозита;
		Иначе
			Движение.Лиды = 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьИзCSV(ТекстCSV) Экспорт
	
	Конверсии.Очистить();
	Для НомерСтроки = 1 По СтрЧислоСтрок(ТекстCSV) Цикл
		Строка = СтрПолучитьСтроку(ТекстCSV, НомерСтроки);
		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Строка, ";");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Если СокрЛП(Части[0]) = "ИдентификаторИгрока" Тогда
			Продолжить; // строка заголовка
		КонецЕсли;
		НоваяСтрока = Конверсии.Добавить();
		НоваяСтрока.ИдентификаторИгрока = СокрЛП(Части[0]);
		Если СокрЛП(Части[1]) = "Депозит" Тогда
			НоваяСтрока.ТипКонверсии = Перечисления.ТипыКонверсий.Депозит;
		Иначе
			НоваяСтрока.ТипКонверсии = Перечисления.ТипыКонверсий.Лид;
		КонецЕсли;
		Если Части.Количество() >= 3 И Не ПустаяСтрока(Части[2]) Тогда
			Попытка
				НоваяСтрока.СуммаДепозита = Число(СтрЗаменить(СокрЛП(Части[2]), ",", "."));
			Исключение
				Сообщить(СтрШаблон("Строка %1: не удалось прочитать сумму депозита ""%2"", установлено 0.",
					НомерСтроки, СокрЛП(Части[2])));
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
