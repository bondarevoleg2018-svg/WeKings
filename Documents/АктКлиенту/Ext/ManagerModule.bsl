
Функция СформироватьПечатнуюФорму(АктСсылка) Экспорт
	
	Макет = Документы.АктКлиенту.ПолучитьМакет("МакетАкта");
	ТабДок = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", АктСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АктКлиенту.Номер КАК Номер,
	|	АктКлиенту.Дата КАК Дата,
	|	АктКлиенту.Клиент КАК Клиент,
	|	АктКлиенту.ДатаНачала КАК ДатаНачала,
	|	АктКлиенту.ДатаОкончания КАК ДатаОкончания,
	|	АктКлиенту.Валюта КАК Валюта
	|ИЗ
	|	Документ.АктКлиенту КАК АктКлиенту
	|ГДЕ
	|	АктКлиенту.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	АктКлиентуНачисления.Кампания КАК Кампания,
	|	АктКлиентуНачисления.Лиды КАК Лиды,
	|	АктКлиентуНачисления.Депозиты КАК Депозиты,
	|	АктКлиентуНачисления.СуммаДепозитов КАК СуммаДепозитов,
	|	АктКлиентуНачисления.Сумма КАК Сумма
	|ИЗ
	|	Документ.АктКлиенту.Начисления КАК АктКлиентуНачисления
	|ГДЕ
	|	АктКлиентуНачисления.Ссылка = &Ссылка";
	Результаты = Запрос.ВыполнитьПакет();
	
	Шапка = Результаты[0].Выбрать();
	Если Не Шапка.Следующий() Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.НомерАкта = Шапка.Номер;
	Область.Параметры.ДатаАкта = Формат(Шапка.Дата, "ДЛФ=D");
	Область.Параметры.Клиент = Шапка.Клиент;
	Область.Параметры.ДатаНачала = Формат(Шапка.ДатаНачала, "ДЛФ=D");
	Область.Параметры.ДатаОкончания = Формат(Шапка.ДатаОкончания, "ДЛФ=D");
	Область.Параметры.Валюта = Шапка.Валюта;
	ТабДок.Вывести(Область);
	
	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
	ЛидыИтого = 0;
	ДепозитыИтого = 0;
	СуммаДепозитовИтого = 0;
	СуммаИтого = 0;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Область);
		ЛидыИтого = ЛидыИтого + Выборка.Лиды;
		ДепозитыИтого = ДепозитыИтого + Выборка.Депозиты;
		СуммаДепозитовИтого = СуммаДепозитовИтого + Выборка.СуммаДепозитов;
		СуммаИтого = СуммаИтого + Выборка.Сумма;
	КонецЦикла;
	
	Область = Макет.ПолучитьОбласть("Итого");
	Область.Параметры.ЛидыИтого = ЛидыИтого;
	Область.Параметры.ДепозитыИтого = ДепозитыИтого;
	Область.Параметры.СуммаДепозитовИтого = СуммаДепозитовИтого;
	Область.Параметры.СуммаИтого = СуммаИтого;
	ТабДок.Вывести(Область);
	ТабДок.Вывести(Макет.ПолучитьОбласть("Подвал"));
	
	ТабДок.Область(1, 1, 1, 1).ШиринаКолонки = 33;
	ТабДок.Область(1, 2, 1, 2).ШиринаКолонки = 10;
	ТабДок.Область(1, 3, 1, 3).ШиринаКолонки = 12;
	ТабДок.Область(1, 4, 1, 4).ШиринаКолонки = 18;
	ТабДок.Область(1, 5, 1, 5).ШиринаКолонки = 15;
	
	Возврат ТабДок;
	
КонецФункции
