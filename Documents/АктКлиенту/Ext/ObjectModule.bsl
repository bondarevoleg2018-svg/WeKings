
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Статус = Перечисления.СтатусыАкта.Черновик;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	СуммаДокумента = Начисления.Итог("Сумма");
	Курс = ПолучитьКурс(Валюта, Дата);
	
	Движения.ВзаиморасчётыСКлиентами.Записывать = Истина;
	Движение = Движения.ВзаиморасчётыСКлиентами.ДобавитьПриход();
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Валюта = Валюта;
	Движение.Сумма = СуммаДокумента;
	Движение.СуммаУпр = СуммаДокумента * Курс;
	
	Если Статус = Перечисления.СтатусыАкта.Черновик Тогда
		Статус = Перечисления.СтатусыАкта.Выставлен;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПоКонверсиям() Экспорт
	
	Начисления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонверсииОбороты.Кампания КАК Кампания,
	|	КонверсииОбороты.Кампания.Оффер.МодельРасчёта КАК МодельРасчёта,
	|	КонверсииОбороты.Кампания.Оффер.СтавкаCPA КАК СтавкаCPA,
	|	КонверсииОбороты.Кампания.Оффер.ПроцентRevShare КАК ПроцентRevShare,
	|	КонверсииОбороты.Кампания.Оффер.Валюта КАК ВалютаОффера,
	|	КонверсииОбороты.ЛидыОборот КАК Лиды,
	|	КонверсииОбороты.ДепозитыОборот КАК Депозиты,
	|	КонверсииОбороты.СуммаДепозитовОборот КАК СуммаДепозитов
	|ИЗ
	|	РегистрНакопления.Конверсии.Обороты(&ДатаНачала, &ДатаОкончания, , Кампания.Оффер.Владелец = &Клиент) КАК КонверсииОбороты";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Начисления.Добавить();
		НоваяСтрока.Кампания = Выборка.Кампания;
		НоваяСтрока.Лиды = Выборка.Лиды;
		НоваяСтрока.Депозиты = Выборка.Депозиты;
		НоваяСтрока.СуммаДепозитов = Выборка.СуммаДепозитов;
		СуммаCPA = 0;
		СуммаRevShare = 0;
		Если Выборка.МодельРасчёта = Перечисления.МоделиРасчёта.CPA
			Или Выборка.МодельРасчёта = Перечисления.МоделиРасчёта.Гибрид Тогда
			СуммаCPA = Выборка.Лиды * Выборка.СтавкаCPA;
		КонецЕсли;
		Если Выборка.МодельРасчёта = Перечисления.МоделиРасчёта.RevShare
			Или Выборка.МодельРасчёта = Перечисления.МоделиРасчёта.Гибрид Тогда
			СуммаRevShare = Выборка.СуммаДепозитов * Выборка.ПроцентRevShare / 100;
		КонецЕсли;
		НоваяСтрока.Сумма = СуммаCPA + СуммаRevShare;
		Если Валюта.Пустая() Тогда
			Валюта = Выборка.ВалютаОффера;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКурс(ВалютаОтбора, НаДату)
	
	Если ВалютаОтбора = Константы.УправленческаяВалюта.Получить() Тогда
		Возврат 1;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Период, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
	Запрос.УстановитьПараметр("Период", НаДату);
	Запрос.УстановитьПараметр("Валюта", ВалютаОтбора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Курс > 0 Тогда
		Возврат Выборка.Курс;
	КонецЕсли;
	Возврат 1;
	
КонецФункции
