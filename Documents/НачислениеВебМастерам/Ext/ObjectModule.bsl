
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	УпрВалюта = Константы.УправленческаяВалюта.Получить();
	
	Движения.НачисленияВебМастерам.Записывать = Истина;
	Движения.ВзаиморасчётыСВебМастерами.Записывать = Истина;
	
	ИтогиПоВебМастерам = Новый Соответствие;
	Для Каждого СтрокаНачисления Из Начисления Цикл
		Движение = Движения.НачисленияВебМастерам.Добавить();
		Движение.Период = Дата;
		Движение.ВебМастер = СтрокаНачисления.ВебМастер;
		Движение.Кампания = СтрокаНачисления.Кампания;
		Движение.Оффер = СтрокаНачисления.Оффер;
		Движение.СуммаУпр = СтрокаНачисления.СуммаУпр;
		
		Итог = ИтогиПоВебМастерам[СтрокаНачисления.ВебМастер];
		Если Итог = Неопределено Тогда
			Итог = 0;
		КонецЕсли;
		ИтогиПоВебМастерам[СтрокаНачисления.ВебМастер] = Итог + СтрокаНачисления.СуммаУпр;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ИтогиПоВебМастерам Цикл
		Движение = Движения.ВзаиморасчётыСВебМастерами.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.ВебМастер = КлючИЗначение.Ключ;
		Движение.Валюта = УпрВалюта;
		Движение.Сумма = КлючИЗначение.Значение;
		Движение.СуммаУпр = КлючИЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоКонверсиям() Экспорт
	
	Начисления.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонверсииОбороты.Кампания КАК Кампания,
	|	КонверсииОбороты.Кампания.ВебМастер КАК ВебМастер,
	|	КонверсииОбороты.Кампания.Оффер КАК Оффер,
	|	СУММА(КонверсииОбороты.ЛидыОборот) КАК Лиды,
	|	СУММА(КонверсииОбороты.ДепозитыОборот) КАК Депозиты,
	|	СУММА(КонверсииОбороты.СуммаДепозитовОборот) КАК СуммаДепозитов
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.Конверсии.Обороты(&ДатаНачала, &ДатаОкончания, , Кампания.ВебМастер <> &ПустойВебМастер) КАК КонверсииОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	КонверсииОбороты.Кампания,
	|	КонверсииОбороты.Кампания.ВебМастер,
	|	КонверсииОбороты.Кампания.Оффер
	|;
	|
	|ВЫБРАТЬ
	|	Обороты.Кампания КАК Кампания,
	|	Обороты.ВебМастер КАК ВебМастер,
	|	Обороты.Оффер КАК Оффер,
	|	Обороты.Лиды КАК Лиды,
	|	Обороты.Депозиты КАК Депозиты,
	|	Обороты.СуммаДепозитов КАК СуммаДепозитов,
	|	ЕСТЬNULL(Условия.Ставка, 0) КАК Ставка,
	|	Условия.МодельВыплаты КАК МодельВыплаты,
	|	ЕСТЬNULL(Курсы.Курс, 1) КАК Курс
	|ИЗ
	|	Обороты КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияВебМастеров.СрезПоследних(&ДатаДокумента, ) КАК Условия
	|		ПО Условия.ВебМастер = Обороты.ВебМастер
	|			И Условия.Оффер = Обороты.Оффер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаДокумента, ) КАК Курсы
	|		ПО Курсы.Валюта = Обороты.Оффер.Валюта";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаДокумента", Дата);
	Запрос.УстановитьПараметр("ПустойВебМастер", Справочники.ВебМастера.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ставка = 0 Или Выборка.МодельВыплаты = NULL Тогда
			Продолжить; // нет условий по паре веб-мастер + оффер
		КонецЕсли;
		Сумма = 0;
		Если Выборка.МодельВыплаты = Перечисления.МоделиРасчёта.CPA
			Или Выборка.МодельВыплаты = Перечисления.МоделиРасчёта.Гибрид Тогда
			Сумма = Сумма + Выборка.Лиды * Выборка.Ставка;
		КонецЕсли;
		Если Выборка.МодельВыплаты = Перечисления.МоделиРасчёта.RevShare
			Или Выборка.МодельВыплаты = Перечисления.МоделиРасчёта.Гибрид Тогда
			Сумма = Сумма + Выборка.СуммаДепозитов * Выборка.Ставка / 100;
		КонецЕсли;
		НоваяСтрока = Начисления.Добавить();
		НоваяСтрока.ВебМастер = Выборка.ВебМастер;
		НоваяСтрока.Кампания = Выборка.Кампания;
		НоваяСтрока.Оффер = Выборка.Оффер;
		НоваяСтрока.Лиды = Выборка.Лиды;
		НоваяСтрока.Депозиты = Выборка.Депозиты;
		НоваяСтрока.СуммаДепозитов = Выборка.СуммаДепозитов;
		НоваяСтрока.Ставка = Выборка.Ставка;
		НоваяСтрока.СуммаУпр = Сумма * Выборка.Курс;
	КонецЦикла;
	
КонецПроцедуры
