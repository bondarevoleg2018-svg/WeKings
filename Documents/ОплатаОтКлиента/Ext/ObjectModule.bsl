
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Акт.Статус <> Перечисления.СтатусыАкта.Выставлен Тогда
		Сообщить("Оплата проводится только по акту в статусе ""Выставлен"".");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ВалютаАкта = Акт.Валюта;
	Курс = ПолучитьКурс(ВалютаАкта, Дата);
	
	Движения.ВзаиморасчётыСКлиентами.Записывать = Истина;
	Движение = Движения.ВзаиморасчётыСКлиентами.ДобавитьРасход();
	Движение.Период = Дата;
	Движение.Клиент = Акт.Клиент;
	Движение.Валюта = ВалютаАкта;
	Движение.Сумма = Сумма;
	Движение.СуммаУпр = Сумма * Курс;
	
	АктОбъект = Акт.ПолучитьОбъект();
	АктОбъект.Статус = Перечисления.СтатусыАкта.Оплачен;
	АктОбъект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Функция ПолучитьКурс(ВалютаОтбора, НаДату)
	
	Если ВалютаОтбора = Константы.УправленческаяВалюта.Получить() Тогда
		Возврат 1;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КурсыВалютСрезПоследних.Курс КАК Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Период, Валюта = &Валюта) КАК КурсыВалютСрезПоследних";
	Запрос.УстановитьПараметр("Период", НаДату);
	Запрос.УстановитьПараметр("Валюта", ВалютаОтбора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Курс > 0 Тогда
		Возврат Выборка.Курс;
	КонецЕсли;
	Возврат 1;
	
КонецФункции
