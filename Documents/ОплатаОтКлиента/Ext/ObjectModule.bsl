
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Контроль здесь, а не в ОбработкаПроведения: подписка на ПриЗаписи
	// меняет статус акта до ОбработкаПроведения (ПередЗаписью → ПриЗаписи → ОбработкаПроведения)
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Акт.Статус <> Перечисления.СтатусыАкта.Выставлен Тогда
		Сообщить("Оплата проводится только по акту в статусе ""Выставлен"".");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ВалютаАкта = Акт.Валюта;
	Курс = РаботаСВалютами.ПолучитьКурс(ВалютаАкта, Дата);
	
	Движения.ВзаиморасчётыСКлиентами.Записывать = Истина;
	Движение = Движения.ВзаиморасчётыСКлиентами.ДобавитьРасход();
	Движение.Период = Дата;
	Движение.Клиент = Акт.Клиент;
	Движение.Валюта = ВалютаАкта;
	Движение.Сумма = Сумма;
	Движение.СуммаУпр = Сумма * Курс;
	
КонецПроцедуры
