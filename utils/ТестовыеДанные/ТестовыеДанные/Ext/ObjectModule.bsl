Функция СформироватьОтчётДерево(К, ИмяОтчёта)
	Попытка
		Схема = Отчеты[ИмяОтчёта].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Настройки = Схема.НастройкиПоУмолчанию;
		ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
		Если ЗначениеПараметра <> Неопределено Тогда
			ЗначениеПараметра.Использование = Истина;
			ЗначениеПараметра.Значение = Новый СтандартныйПериод(К.ДатаНачалаПериода, К.ДатаОкончанияПериода);
		КонецЕсли;
		// проверка дефекта итерации 15: ресурсы должны быть в выбранных полях схемы, без принудительного добавления
		Недостающие = "";
		Для Каждого ПолеИтога Из Схема.ПоляИтога Цикл
			ПолеНайдено = Ложь;
			Для Каждого ЭлементВыбора Из Настройки.Выбор.Элементы Цикл
				Если ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных")
					И Строка(ЭлементВыбора.Поле) = ПолеИтога.ПутьКДанным Тогда
					ПолеНайдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не ПолеНайдено Тогда
				Недостающие = Недостающие + ПолеИтога.ПутьКДанным + ",";
			КонецЕсли;
		КонецЦикла;
		Если Недостающие = "" Тогда
			ШагОК(К, "7. ВЫБОР " + ИмяОтчёта + ": ресурсы в выбранных полях", "все поля итогов выбраны — ОК");
		Иначе
			ШагПровал(К, "7. ВЫБОР " + ИмяОтчёта + ": ресурсы в выбранных полях", "не выбраны: " + Недостающие);
		КонецЕсли;
		Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
		Макет = Компоновщик.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(Макет);
		ДЗ = Новый ДеревоЗначений;
		Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		Вывод.УстановитьОбъект(ДЗ);
		Вывод.Вывести(Процессор);
		ИменаКолонок = "";
		Для Каждого КолонкаДЗ Из ДЗ.Колонки Цикл
			ИменаКолонок = ИменаКолонок + КолонкаДЗ.Имя + ",";
		КонецЦикла;
		ДобавитьЛог(К, "Диагностика: колонки " + ИмяОтчёта + ": " + ИменаКолонок);
		Если ДЗ.Строки.Количество() > 0 Тогда
			ШагОК(К, "7. ОТЧЁТ " + ИмяОтчёта, "групп верхнего уровня: " + ДЗ.Строки.Количество() + " — ОК");
			Возврат ДЗ;
		Иначе
			ШагПровал(К, "7. ОТЧЁТ " + ИмяОтчёта, "ПУСТО");
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ТекстОшибки = Инфо.Описание + " [" + Инфо.ИмяМодуля + ":" + Инфо.НомерСтроки + "]";
		Причина = Инфо.Причина;
		Пока Причина <> Неопределено Цикл
			ТекстОшибки = ТекстОшибки + " <- " + Причина.Описание;
			Причина = Причина.Причина;
		КонецЦикла;
		ШагПровал(К, "7. ОТЧЁТ " + ИмяОтчёта, ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СуммаВерхнегоУровня(ДЗ, ИмяРесурса, ИмяГруппы)
	Если ДЗ.Колонки.Найти(ИмяРесурса) = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Сумма = 0;
	Для Каждого Строка Из ДЗ.Строки Цикл
		Если Строка[ИмяГруппы] = NULL Или Строка[ИмяГруппы] = Неопределено Тогда
			Продолжить; // строка общего итога
		КонецЕсли;
		Значение = Строка[ИмяРесурса];
		Если Значение <> NULL Тогда
			Сумма = Сумма + Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;
КонецФункции

Процедура Шаг7_Отчёты(К)

	// КонверсииПоКампаниям (Канал → Страна → Кампания): лиды 2 + 3 + 1 + 3 (капа) = 9
	ДЗ = СформироватьОтчётДерево(К, "КонверсииПоКампаниям");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ КонверсииПоКампаниям: итог лидов", 9, СуммаВерхнегоУровня(ДЗ, "Лиды", "Канал"));
		СтрокиКипр = ДЗ.Строки.НайтиСтроки(Новый Структура("Страна", К.СтранаКипр), Истина);
		ЛидовКипр = 0;
		Если ДЗ.Колонки.Найти("Лиды") <> Неопределено Тогда
			Для Каждого СтрокаКипр Из СтрокиКипр Цикл
				Если СтрокаКипр.Кампания = NULL Или СтрокаКипр.Кампания = Неопределено Тогда
					ЛидовКипр = ЛидовКипр + СтрокаКипр.Лиды;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если СтрокиКипр.Количество() > 0 Тогда
			ПроверитьРавно(К, "7. ОТЧЁТ КонверсииПоКампаниям: ГЕО Кипр, лиды (3 + 1)", 4, ЛидовКипр);
		Иначе
			ШагПровал(К, "7. ОТЧЁТ КонверсииПоКампаниям: ГЕО Кипр", "страна не найдена в результате");
		КонецЕсли;
	КонецЕсли;

	// ВзаиморасчётыСКлиентами (Клиент → Валюта): остаток Клиент2 2000 EUR x 1.1
	ДЗ = СформироватьОтчётДерево(К, "ВзаиморасчётыСКлиентами");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ ВзаиморасчётыСКлиентами: итог СуммаУпр кон. остатка", 2200,
			СуммаВерхнегоУровня(ДЗ, "СуммаУпрКонечныйОстаток", "Клиент"));
	КонецЕсли;

	// РасчётыСВебМастерами (ВебМастер → Валюта): остаток ВМ2 = 1650 упр.
	ДЗ = СформироватьОтчётДерево(К, "РасчётыСВебМастерами");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ РасчётыСВебМастерами: итог СуммаУпр кон. остатка", 1650,
			СуммаВерхнегоУровня(ДЗ, "СуммаУпрКонечныйОстаток", "ВебМастер"));
	КонецЕсли;

	// ВыручкаПоМоделямРасчёта (МодельРасчёта → Клиент): 420 (Клиент1) + 2000 (Клиент2)
	ДЗ = СформироватьОтчётДерево(К, "ВыручкаПоМоделямРасчёта");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ ВыручкаПоМоделямРасчёта: итог выручки", 2420, СуммаВерхнегоУровня(ДЗ, "Выручка", "МодельРасчёта"));
	КонецЕсли;

	// ROIПоКампаниям (Кампания): доход К1 = 100, К2 = 290 (расходы есть только у них)
	ДЗ = СформироватьОтчётДерево(К, "ROIПоКампаниям");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ ROIПоКампаниям: итог дохода (100 + 290)", 390, СуммаВерхнегоУровня(ДЗ, "Доход", "Кампания"));
		ПроверитьРавно(К, "7. ОТЧЁТ ROIПоКампаниям: итог расхода (100 + 200)", 300, СуммаВерхнегоУровня(ДЗ, "Расход", "Кампания"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

