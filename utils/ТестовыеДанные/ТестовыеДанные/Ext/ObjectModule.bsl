Процедура Шаг3_Капа(К)

	// Легальная загрузка: 3 лида при капе 5 — должна провестись
	ДокКапа1 = НоваяЗагрузкаЛидов(Дата(2025, 10, 18, 10, 0, 0), К.КампанияКапа);
	Для Ном = 1 По 3 Цикл
		ДобавитьСтрокуКонверсии(ДокКапа1, "cap_legal_" + Ном, Перечисления.ТипыКонверсий.Лид);
	КонецЦикла;
	ДокКапа1.Записать(РежимЗаписиДокумента.Проведение);
	ПроверитьРавно(К, "3. Капа: 3 лида из 5 провелись", Истина, ДокКапа1.Проведен);

	// Превышение: ещё 3 лида (3 + 3 = 6 > 5) — должно отказаться
	ДокКапа2 = НоваяЗагрузкаЛидов(Дата(2025, 10, 19, 10, 0, 0), К.КампанияКапа);
	Для Ном = 1 По 3 Цикл
		ДобавитьСтрокуКонверсии(ДокКапа2, "cap_over_" + Ном, Перечисления.ТипыКонверсий.Лид);
