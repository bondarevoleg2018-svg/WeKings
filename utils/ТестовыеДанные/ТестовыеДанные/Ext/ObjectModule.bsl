Функция НайтиСоздатьЭлемент(ИмяСправочника, Наименование)
	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция НайтиСоздатьОффер(Наименование, Владелец, Модель, СтавкаCPA, ПроцентRevShare, Валюта, Капа)
	Ссылка = Справочники.Офферы.НайтиПоНаименованию(Наименование, Истина, , Владелец);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.Офферы.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.Владелец = Владелец;
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Объект.МодельРасчёта = Модель;
	Объект.СтавкаCPA = СтавкаCPA;
	Объект.ПроцентRevShare = ПроцентRevShare;
	Объект.Валюта = Валюта;
	Объект.КапаЛидовВМесяц = Капа;
	Объект.Активен = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция НайтиСоздатьКампанию(К, Наименование, Оффер, ВебМастер, Канал, Страна)
	Ссылка = Справочники.РекламныеКампании.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.РекламныеКампании.СоздатьЭлемент();
		Объект.Наименование = Наименование;
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Объект.Оффер = Оффер;
	Объект.ВебМастер = ВебМастер;
	Объект.Канал = Канал;
	Объект.Страна = Страна;
	Объект.ДатаНачала = К.ДатаНачалаПериода;
	Объект.ДатаОкончания = К.ДатаОкончанияПериода;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура ЗаписатьКурс(Валюта, Период, Курс)
	Набор = РегистрыСведений.КурсыВалют.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Период);
	Набор.Отбор.Валюта.Установить(Валюта);
	Запись = Набор.Добавить();
	Запись.Период = Период;
	Запись.Валюта = Валюта;
	Запись.Курс = Курс;
	Набор.Записать();
КонецПроцедуры

Процедура ЗаписатьУсловие(ВебМастер, Оффер, Период, Ставка, МодельВыплаты)
	Набор = РегистрыСведений.УсловияВебМастеров.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Период);
	Набор.Отбор.ВебМастер.Установить(ВебМастер);
	Набор.Отбор.Оффер.Установить(Оффер);
	Запись = Набор.Добавить();
	Запись.Период = Период;
	Запись.ВебМастер = ВебМастер;
	Запись.Оффер = Оффер;
	Запись.Ставка = Ставка;
	Запись.МодельВыплаты = МодельВыплаты;
	Набор.Записать();
КонецПроцедуры

Функция КаналТрафика(Наименование)
	Ссылка = Справочники.КаналыТрафика.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.КаналыТрафика.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ЗапросЧисло(ТекстЗапроса, Параметры)
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого КлючИЗначение Из Параметры Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка[0] <> Null Тогда
		Возврат Выборка[0];
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция ПровестиСОтказом(ДокОбъект)
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Не ДокОбъект.Проведен;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция СтатусАкта(АктСсылка)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	АктКлиенту.Статус КАК Статус
	|ИЗ
	|	Документ.АктКлиенту КАК АктКлиенту
	|ГДЕ
	|	АктКлиенту.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", АктСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.Статус);
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура ДобавитьСтрокуКонверсии(ДокОбъект, Идентификатор, ТипКонверсии, СуммаДепозита = 0)
	Строка = ДокОбъект.Конверсии.Добавить();
