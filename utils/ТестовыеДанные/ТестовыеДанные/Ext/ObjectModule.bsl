	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Объект.Оффер = Оффер;
	Объект.ВебМастер = ВебМастер;
	Объект.Канал = Канал;
	Объект.Страна = Страна;
