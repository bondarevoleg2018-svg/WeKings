Функция СформироватьОтчётДерево(К, ИмяОтчёта)
	Попытка
		Схема = Отчеты[ИмяОтчёта].ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		Настройки = Схема.НастройкиПоУмолчанию;
		ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
		Если ЗначениеПараметра <> Неопределено Тогда
			ЗначениеПараметра.Использование = Истина;
			ЗначениеПараметра.Значение = Новый СтандартныйПериод(К.ДатаНачалаПериода, К.ДатаОкончанияПериода);
		КонецЕсли;
		// проверка дефекта итерации 15: ресурсы должны быть в выбранных полях схемы, без принудительного добавления
		Недостающие = "";
		Для Каждого ПолеИтога Из Схема.ПоляИтога Цикл
			ПолеНайдено = Ложь;
			Для Каждого ЭлементВыбора Из Настройки.Выбор.Элементы Цикл
				Если ТипЗнч(ЭлементВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных")
					И Строка(ЭлементВыбора.Поле) = ПолеИтога.ПутьКДанным Тогда
					ПолеНайдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не ПолеНайдено Тогда
				Недостающие = Недостающие + ПолеИтога.ПутьКДанным + ",";
			КонецЕсли;
		КонецЦикла;
		Если Недостающие = "" Тогда
			ШагОК(К, "7. ВЫБОР " + ИмяОтчёта + ": ресурсы в выбранных полях", "все поля итогов выбраны — ОК");
		Иначе
			ШагПровал(К, "7. ВЫБОР " + ИмяОтчёта + ": ресурсы в выбранных полях", "не выбраны: " + Недостающие);
		КонецЕсли;
		Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
		Макет = Компоновщик.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(Макет);
		ДЗ = Новый ДеревоЗначений;
		Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		Вывод.УстановитьОбъект(ДЗ);
		Вывод.Вывести(Процессор);
		ИменаКолонок = "";
		Для Каждого КолонкаДЗ Из ДЗ.Колонки Цикл
			ИменаКолонок = ИменаКолонок + КолонкаДЗ.Имя + ",";
		КонецЦикла;
		ДобавитьЛог(К, "Диагностика: колонки " + ИмяОтчёта + ": " + ИменаКолонок);
		Если ДЗ.Строки.Количество() > 0 Тогда
			ШагОК(К, "7. ОТЧЁТ " + ИмяОтчёта, "групп верхнего уровня: " + ДЗ.Строки.Количество() + " — ОК");
			Возврат ДЗ;
		Иначе
			ШагПровал(К, "7. ОТЧЁТ " + ИмяОтчёта, "ПУСТО");
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ТекстОшибки = Инфо.Описание + " [" + Инфо.ИмяМодуля + ":" + Инфо.НомерСтроки + "]";
		Причина = Инфо.Причина;
		Пока Причина <> Неопределено Цикл
			ТекстОшибки = ТекстОшибки + " <- " + Причина.Описание;
			Причина = Причина.Причина;
		КонецЦикла;
		ШагПровал(К, "7. ОТЧЁТ " + ИмяОтчёта, ТекстОшибки);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция СуммаВерхнегоУровня(ДЗ, ИмяРесурса, ИмяГруппы)
	Если ДЗ.Колонки.Найти(ИмяРесурса) = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Сумма = 0;
	Для Каждого Строка Из ДЗ.Строки Цикл
		Если Строка[ИмяГруппы] = NULL Или Строка[ИмяГруппы] = Неопределено Тогда
			Продолжить; // строка общего итога
		КонецЕсли;
		Значение = Строка[ИмяРесурса];
		Если Значение <> NULL Тогда
			Сумма = Сумма + Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;
КонецФункции

Процедура Шаг7_Отчёты(К)

	// КонверсииПоКампаниям (Канал → Страна → Кампания): лиды 2 + 3 + 1 + 3 (капа) = 9
	ДЗ = СформироватьОтчётДерево(К, "КонверсииПоКампаниям");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ КонверсииПоКампаниям: итог лидов", 9, СуммаВерхнегоУровня(ДЗ, "Лиды", "Канал"));
		СтрокиКипр = ДЗ.Строки.НайтиСтроки(Новый Структура("Страна", К.СтранаКипр), Истина);
		ЛидовКипр = 0;
		Если ДЗ.Колонки.Найти("Лиды") <> Неопределено Тогда
			Для Каждого СтрокаКипр Из СтрокиКипр Цикл
				Если СтрокаКипр.Кампания = NULL Или СтрокаКипр.Кампания = Неопределено Тогда
					ЛидовКипр = ЛидовКипр + СтрокаКипр.Лиды;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если СтрокиКипр.Количество() > 0 Тогда
			ПроверитьРавно(К, "7. ОТЧЁТ КонверсииПоКампаниям: ГЕО Кипр, лиды (3 + 1)", 4, ЛидовКипр);
		Иначе
			ШагПровал(К, "7. ОТЧЁТ КонверсииПоКампаниям: ГЕО Кипр", "страна не найдена в результате");
		КонецЕсли;
		ПроверитьРавно(К, "7. ОТЧЁТ КонверсииПоКампаниям: итог суммы депозитов, упр (800 + 1000 + 5000x1.1)", 7300,
			СуммаВерхнегоУровня(ДЗ, "СуммаДепозитовУпр", "Канал"));
		СуммаУпрКипр = 0;
		Если ДЗ.Колонки.Найти("СуммаДепозитовУпр") <> Неопределено Тогда
			Для Каждого СтрокаКипр Из СтрокиКипр Цикл
				Если СтрокаКипр.Кампания = NULL Или СтрокаКипр.Кампания = Неопределено Тогда
					СуммаУпрКипр = СуммаУпрКипр + СтрокаКипр.СуммаДепозитовУпр;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ПроверитьРавно(К, "7. ОТЧЁТ КонверсииПоКампаниям: ГЕО Кипр, сумма депозитов, упр (1000 + 5500)", 6500, СуммаУпрКипр);
	КонецЕсли;

	// ВзаиморасчётыСКлиентами (Клиент, валюта — колонкой, без вложенной группировки)
	ДЗ = СформироватьОтчётДерево(К, "ВзаиморасчётыСКлиентами");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ ВзаиморасчётыСКлиентами: итог СуммаУпр кон. остатка", 2200,
			СуммаВерхнегоУровня(ДЗ, "СуммаУпрКонечныйОстаток", "Клиент"));
		СтрокиКлиента = ДЗ.Строки.НайтиСтроки(Новый Структура("Клиент", К.Клиент1));
		Если СтрокиКлиента.Количество() = 1 Тогда
			ПроверитьРавно(К, "7. ОТЧЁТ ВзаиморасчётыСКлиентами: валюта колонкой у Клиент1", К.ВалютаUSD, СтрокиКлиента[0].Валюта);
			ПроверитьРавно(К, "7. ОТЧЁТ ВзаиморасчётыСКлиентами: нет вложенных строк-валют", 0, СтрокиКлиента[0].Строки.Количество());
		Иначе
			ШагПровал(К, "7. ОТЧЁТ ВзаиморасчётыСКлиентами: строка Клиент1", "не найдена или задублирована");
		КонецЕсли;
	КонецЕсли;

	// РасчётыСВебМастерами (ВебМастер, валюта — колонкой, без вложенной группировки)
	ДЗ = СформироватьОтчётДерево(К, "РасчётыСВебМастерами");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ РасчётыСВебМастерами: итог СуммаУпр кон. остатка", 1650,
			СуммаВерхнегоУровня(ДЗ, "СуммаУпрКонечныйОстаток", "ВебМастер"));
		СтрокиВМ = ДЗ.Строки.НайтиСтроки(Новый Структура("ВебМастер", К.ВебМастер1));
		Если СтрокиВМ.Количество() = 1 Тогда
			ПроверитьРавно(К, "7. ОТЧЁТ РасчётыСВебМастерами: валюта колонкой у ВМ1", К.ВалютаUSD, СтрокиВМ[0].Валюта);
			ПроверитьРавно(К, "7. ОТЧЁТ РасчётыСВебМастерами: нет вложенных строк-валют", 0, СтрокиВМ[0].Строки.Количество());
		Иначе
			ШагПровал(К, "7. ОТЧЁТ РасчётыСВебМастерами: строка ВМ1", "не найдена или задублирована");
		КонецЕсли;
	КонецЕсли;

	// ВыручкаПоМоделямРасчёта (МодельРасчёта → Клиент), выручка в упр. валюте: 420 (Клиент1, USD) + 2000 x 1.1 (Клиент2, EUR)
	ДЗ = СформироватьОтчётДерево(К, "ВыручкаПоМоделямРасчёта");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ ВыручкаПоМоделямРасчёта: итог выручки, упр (420 + 2200)", 2620, СуммаВерхнегоУровня(ДЗ, "Выручка", "МодельРасчёта"));
	КонецЕсли;

	// ROIПоКампаниям (Кампания): доход К1 = 100, К2 = 290 (расходы есть только у них)
	ДЗ = СформироватьОтчётДерево(К, "ROIПоКампаниям");
	Если ДЗ <> Неопределено Тогда
		ПроверитьРавно(К, "7. ОТЧЁТ ROIПоКампаниям: итог дохода (100 + 290)", 390, СуммаВерхнегоУровня(ДЗ, "Доход", "Кампания"));
		ПроверитьРавно(К, "7. ОТЧЁТ ROIПоКампаниям: итог расхода (100 + 200)", 300, СуммаВерхнегоУровня(ДЗ, "Расход", "Кампания"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Процедура ВыполнитьВсеТесты() Экспорт

	К = НовыйКонтекст();
	ДобавитьЛог(К, "=== WeKings: прогон тестовых данных (итерация 18) ===");
	ДобавитьЛог(К, "Дата запуска: " + ТекущаяДата());
	ДобавитьЛог(К, "Период тестовых данных: 01.10.2025 - 31.10.2025");

	Попытка

		ПостроитьИндексыДокументов(К);

		Попытка
			Шаг1_НСИ(К);
		Исключение
			ШагПровал(К, "1. НСИ", ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Шаг2_ЗагрузкаЛидов(К);
		Исключение
			ШагПровал(К, "2. ЗагрузкаЛидов", ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Шаг3_Капа(К);
		Исключение
			ШагПровал(К, "3. Капа", ОписаниеОшибки());
		КонецПопытки;

		АктСсылка = Неопределено;
		Попытка
			АктСсылка = Шаг4_АктКлиенту(К);
		Исключение
			ШагПровал(К, "4. АктКлиенту", ОписаниеОшибки());
		КонецПопытки;

		Если АктСсылка <> Неопределено Тогда
			Попытка
				Шаг5_ОплатаОтКлиента(К, АктСсылка);
			Исключение
				ШагПровал(К, "5. ОплатаОтКлиента", ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		Попытка
			Шаг5б_АктКлиентуEUR(К);
		Исключение
			ШагПровал(К, "5б. АктКлиенту EUR", ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Шаг6_РасчётыСВебМастерами(К);
		Исключение
			ШагПровал(К, "6. РасчётыСВебМастерами", ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Шаг6б_РасходНаРекламу(К);
		Исключение
			ШагПровал(К, "6б. РасходНаРекламу", ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Шаг7_Отчёты(К);
		Исключение
			ШагПровал(К, "7. Отчёты", ОписаниеОшибки());
		КонецПопытки;

	Исключение
		ШагПровал(К, "КРИТИЧЕСКИЙ СБОЙ", ОписаниеОшибки());
	КонецПопытки;

	ДобавитьЛог(К, "Документы: переиспользовано " + К.Переиспользовано + ", создано новых " + К.СозданоНовых
		+ " (транзитных негативных " + К.СозданоТранзитных + "), дублей по ключу помечено " + К.ДублейПомечено);
	Если К.СозданоНовых = 0 Тогда
		ШагОК(К, "8. Идемпотентность: новых документов = 0 (транзитные негативы не в счёт)");
	Иначе
		ДобавитьЛог(К, "8. Идемпотентность: создано новых " + К.СозданоНовых + " (при повторном прогоне ожидается 0)");
	КонецЕсли;

	ДобавитьЛог(К, "=== ИТОГ: PASS = " + К.СчетОК + ", FAIL = " + К.СчетПровал + " ===");

	ЗаписатьЛог(К);

КонецПроцедуры
