		ШагОК(К, Имя, "ожидалось: " + Ожидалось + ", получено: " + Получилось);
	Иначе
		ШагПровал(К, Имя, "ожидалось: " + Ожидалось + ", получено: " + Получилось);
	КонецЕсли;
