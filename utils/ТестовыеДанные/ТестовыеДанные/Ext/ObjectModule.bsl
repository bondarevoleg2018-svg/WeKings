	ЗаписатьУсловие(ВебМастер1, ОфферHybrid, К.ДатаНачалаПериода, 15, Перечисления.МоделиРасчёта.Гибрид);
	ЗаписатьУсловие(ВебМастер2, ОфферRevShare, К.ДатаНачалаПериода, 30, Перечисления.МоделиРасчёта.RevShare);
	ДобавитьЛог(К, "Диагностика: канал PPC найден по наименованию: " + (Не Справочники.КаналыТрафика.НайтиПоНаименованию("PPC", Истина).Пустая()));
	К.Вставить("Кампания1", НайтиСоздатьКампанию(К, "PPC Gold", ОфферCPA, ВебМастер1, КаналТрафика("PPC"), СтранаКюрасао));
