Функция СтатусАкта(АктСсылка)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	АктКлиенту.Статус КАК Статус
	|ИЗ
	|	Документ.АктКлиенту КАК АктКлиенту
	|ГДЕ
	|	АктКлиенту.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", АктСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.Статус);
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура ДобавитьСтрокуКонверсии(ДокОбъект, Идентификатор, ТипКонверсии, СуммаДепозита = 0)
