		Исключение
			ШагПровал(К, "4. АктКлиенту", ОписаниеОшибки());
		КонецПопытки;

		Если АктСсылка <> Неопределено Тогда
			Попытка
				Шаг5_ОплатаОтКлиента(К, АктСсылка);
			Исключение
				ШагПровал(К, "5. ОплатаОтКлиента", ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

