Функция НовыйКонтекст()
	К = Новый Структура;
	К.Вставить("ЛогСтроки", Новый Массив);
	К.Вставить("СчетОК", 0);
	К.Вставить("СчетПровал", 0);
	К.Вставить("ДатаНачалаПериода", Дата(2025, 10, 1));
	К.Вставить("ДатаОкончанияПериода", Дата(2025, 10, 31, 23, 59, 59));
	К.Вставить("Индексы", Новый Соответствие); // ИмяТипа -> Соответствие(ключ -> Ссылка) непомеченных документов
	К.Вставить("СозданоНовых", 0);
	К.Вставить("СозданоТранзитных", 0); // негативные тесты: документ не сохраняется в базе (отказ при проведении), создаётся заново каждый прогон
	К.Вставить("Переиспользовано", 0);
	К.Вставить("ДублейПомечено", 0);
	Возврат К;
КонецФункции

Функция ДатаСценария(К, День, Часы = 10, Минуты = 0)
