Процедура Шаг2_ЗагрузкаЛидов(К)

	// Документ 1: заполнение через ЗагрузитьИзCSV (серверный метод объекта, без клиентского диалога)
	Док1 = НайтиСоздатьДокумент(К, "ЗагрузкаЛидов", ДатаСценария(К, 15, 10), Новый Структура("Кампания", К.Кампания1));
	ТекстCSV = "ИдентификаторИгрока;Тип;Сумма
	|player1;Лид;
	|player2;Лид;
	|player3;Депозит;500
