	ОфферRevShare = НайтиСоздатьОффер("Lion RevShare", Клиент2, Перечисления.МоделиРасчёта.RevShare, 0, 40, ВалютаEUR, 0);
	ОфферКапа = НайтиСоздатьОффер("Cap Limited", Клиент1, Перечисления.МоделиРасчёта.CPA, 10, 0, ВалютаUSD, 5);
	К.Вставить("ОфферCPA", ОфферCPA);
