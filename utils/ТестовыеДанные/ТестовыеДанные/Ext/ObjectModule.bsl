#Область ШагиТеста

Процедура ОчиститьТестовыеДокументы(К)
	Типы = Новый Массив;
	Типы.Добавить("ОплатаОтКлиента");
	Типы.Добавить("ВыплатаВебМастеру");
	Типы.Добавить("АктКлиенту");
	Типы.Добавить("НачислениеВебМастерам");
	Типы.Добавить("РасходНаРекламу");
	Типы.Добавить("ЗагрузкаЛидов");
	Всего = 0;
	Для Каждого ИмяТипа Из Типы Цикл
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяТипа + " КАК Док
		|ГДЕ
		|	Док.Дата >= &Начало И Док.Дата <= &Конец");
		Запрос.УстановитьПараметр("Начало", К.ДатаНачалаПериода);
		Запрос.УстановитьПараметр("Конец", К.ДатаОкончанияПериода);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект.Проведен Тогда
				Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Объект.УстановитьПометкуУдаления(Истина);
			Всего = Всего + 1;
		КонецЦикла;
	КонецЦикла;
	ДобавитьЛог(К, "Очистка периода: распроведено и помечено на удаление документов: " + Всего);
КонецПроцедуры

Процедура Шаг1_НСИ(К)
	ВалютаUSD = НайтиСоздатьЭлемент("Валюты", "USD");
