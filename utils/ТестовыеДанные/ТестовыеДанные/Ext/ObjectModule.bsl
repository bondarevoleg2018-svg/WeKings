// Ключ документа из значений полей: дата + реквизиты в фиксированном порядке.
// XMLСтрока даёт каноничное представление (дата, uuid ссылки, число).
Функция КлючИзЗначений(ДатаДок, ЗначенияПолей)
	Части = Новый Массив;
	Части.Добавить(XMLСтрока(ДатаДок));
	Для Каждого Эл Из ЗначенияПолей Цикл
		Части.Добавить(XMLСтрока(Эл.Значение));
	КонецЦикла;
	Возврат СтрСоединить(Части, "|");
КонецФункции

// Один запрос на тип документа: все непомеченные за период -> Соответствие(ключ -> Ссылка).
Процедура ПостроитьИндексТипа(К, ИмяТипа, ИменаПолей)
	ТекстПоля = "";
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		ТекстПоля = ТекстПоля + ", Док." + ИмяПоля + " КАК " + ИмяПоля;
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка, Док.Дата КАК Дата" + ТекстПоля + "
	|ИЗ
	|	Документ." + ИмяТипа + " КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &Н И &К
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Ссылка");
	Запрос.УстановитьПараметр("Н", К.ДатаНачалаПериода);
	Запрос.УстановитьПараметр("К", К.ДатаОкончанияПериода);
	Выборка = Запрос.Выполнить().Выбрать();
	Индекс = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ЗначенияПолей = Новый Структура;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			ЗначениеПоля = Выборка[ИмяПоля];
			Если ИмяПоля = "Валюта" И Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
				// наследие до итерации 18: у выплат валюта не хранилась, сумма всегда в упр. валюте
				ЗначениеПоля = Константы.УправленческаяВалюта.Получить();
			КонецЕсли;
			ЗначенияПолей.Вставить(ИмяПоля, ЗначениеПоля);
		КонецЦикла;
		Ключ = КлючИзЗначений(Выборка.Дата, ЗначенияПолей);
		Если Индекс[Ключ] = Неопределено Тогда
			Индекс.Вставить(Ключ, Выборка.Ссылка);
		Иначе
			// дубль по ключу (артефакт прошлых прогонов): оставляем первый, дубль помечаем
			ОбъектДубль = Выборка.Ссылка.ПолучитьОбъект();
			Если ОбъектДубль.Проведен Тогда
				ОбъектДубль.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			ОбъектДубль.УстановитьПометкуУдаления(Истина);
			К.ДублейПомечено = К.ДублейПомечено + 1;
		КонецЕсли;
	КонецЦикла;
	К.Индексы.Вставить(ИмяТипа, Индекс);
КонецПроцедуры

Процедура ПостроитьИндексыДокументов(К)
	ПостроитьИндексТипа(К, "ЗагрузкаЛидов", СтрРазделить("Кампания", ","));
	ПостроитьИндексТипа(К, "АктКлиенту", СтрРазделить("Клиент,Валюта", ","));
	ПостроитьИндексТипа(К, "ОплатаОтКлиента", СтрРазделить("Акт,Сумма", ","));
	ПостроитьИндексТипа(К, "НачислениеВебМастерам", СтрРазделить("ДатаНачала", ","));
	ПостроитьИндексТипа(К, "ВыплатаВебМастеру", СтрРазделить("ВебМастер,Сумма,Валюта", ","));
	ПостроитьИндексТипа(К, "РасходНаРекламу", СтрРазделить("Кампания,СуммаУпр", ","));
	ДобавитьЛог(К, "Индекс непомеченных документов: ЗагрузкаЛидов " + К.Индексы["ЗагрузкаЛидов"].Количество()
		+ ", АктКлиенту " + К.Индексы["АктКлиенту"].Количество()
		+ ", ОплатаОтКлиента " + К.Индексы["ОплатаОтКлиента"].Количество()
		+ ", НачислениеВебМастерам " + К.Индексы["НачислениеВебМастерам"].Количество()
		+ ", ВыплатаВебМастеру " + К.Индексы["ВыплатаВебМастеру"].Количество()
		+ ", РасходНаРекламу " + К.Индексы["РасходНаРекламу"].Количество());
КонецПроцедуры

// Find-or-create: ищет непомеченный документ по ключу (дата + ключевые поля),
// найденный перезаполняет, ненайденный создаёт. Помеченные на удаление не воскрешаются.
Функция НайтиСоздатьДокумент(К, ИмяТипа, ДатаДок, КлючевыеПоля, ЗаполняемыеПоля = Неопределено, Транзитный = Ложь)
	Ключ = КлючИзЗначений(ДатаДок, КлючевыеПоля);
	Ссылка = К.Индексы[ИмяТипа][Ключ];
	Если Ссылка = Неопределено Тогда
		Док = Документы[ИмяТипа].СоздатьДокумент();
		Док.Дата = ДатаДок;
		Если Транзитный Тогда
			К.СозданоТранзитных = К.СозданоТранзитных + 1;
		Иначе
			К.СозданоНовых = К.СозданоНовых + 1;
		КонецЕсли;
	Иначе
		Док = Ссылка.ПолучитьОбъект();
		К.Переиспользовано = К.Переиспользовано + 1;
	КонецЕсли;
	Для Каждого Эл Из КлючевыеПоля Цикл
		Док[Эл.Ключ] = Эл.Значение;
	КонецЦикла;
	Если ЗаполняемыеПоля <> Неопределено Тогда
		Для Каждого Эл Из ЗаполняемыеПоля Цикл
			Док[Эл.Ключ] = Эл.Значение;
		КонецЦикла;
	КонецЕсли;
	Возврат Док;
КонецФункции

