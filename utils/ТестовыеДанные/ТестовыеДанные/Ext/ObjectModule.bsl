	К.Вставить("ВебМастер2", ВебМастер2);
	ЗаписатьКурс(ВалютаEUR, К.ДатаНачалаПериода, 1.1);
	ЗаписатьКурс(ВалютаRUB, К.ДатаНачалаПериода, 0.011);
