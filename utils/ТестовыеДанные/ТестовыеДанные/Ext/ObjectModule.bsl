	ДобавитьЛог(К, "FAIL | " + Имя + ?(Детали = "", "", " | " + Детали));
КонецПроцедуры

Процедура ПроверитьРавно(К, Имя, Ожидалось, Получилось)
	Если Получилось = Ожидалось Тогда
		ШагОК(К, Имя, "ожидалось: " + Ожидалось + ", получено: " + Получилось);
	Иначе
		ШагПровал(К, Имя, "ожидалось: " + Ожидалось + ", получено: " + Получилось);
	КонецЕсли;
КонецПроцедуры

