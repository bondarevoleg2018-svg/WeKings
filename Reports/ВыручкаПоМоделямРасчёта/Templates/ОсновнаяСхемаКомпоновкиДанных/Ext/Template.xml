		<query>ВЫБРАТЬ
	АктКлиентуНачисления.Кампания.Оффер.МодельРасчёта КАК МодельРасчёта,
	АктКлиентуНачисления.Ссылка.Клиент КАК Клиент,
	СУММА(АктКлиентуНачисления.Сумма) КАК Выручка,
	СУММА(АктКлиентуНачисления.Лиды) КАК Лиды,
	СУММА(АктКлиентуНачисления.Депозиты) КАК Депозиты
ИЗ
	Документ.АктКлиенту.Начисления КАК АктКлиентуНачисления
ГДЕ
	АктКлиентуНачисления.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
	И АктКлиентуНачисления.Ссылка.Проведен
СГРУППИРОВАТЬ ПО
	АктКлиентуНачисления.Кампания.Оффер.МодельРасчёта,
	АктКлиентуНачисления.Ссылка.Клиент</query>
